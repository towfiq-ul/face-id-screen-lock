<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.facelock.monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>@BIN_DIR@/facelock-monitor</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/facelock-monitor.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/facelock-monitor.err</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
